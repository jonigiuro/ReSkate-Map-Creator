{
  "name": "reskate-map-creator",
  "private": true,
  "version": "0.2.6",
  "description": "ReSkate Map Creator — place kit pieces and export Studio-oriented .blend files",
  "author": "ReSkate Map Creator",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "desktop": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on http://127.0.0.1:47321 && electron .\"",
    "desktop:prod": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --linux AppImage dir",
    "build:desktop:win": "npm run build && electron-builder --win dir --config.electronDist=node_modules/electron/dist && node scripts/copy_objects.mjs",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 47321",
    "export:blend": "node scripts/export_cli.mjs",
    "export:demo": "node scripts/export_cli.mjs exports/demo-scene.json exports/demo-map.blend"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@types/three": "^0.186.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.reskate.mapcreator",
    "productName": "ReSkate Map Creator",
    "copyright": "Copyright © ReSkate Map Creator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/blender_export.mjs",
      "scripts/library_catalog.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/export_blend.py",
        "to": "scripts/export_blend.py"
      },
      {
        "from": "scripts/preview_asset.py",
        "to": "scripts/preview_asset.py"
      },
      {
        "from": "scripts/sk8_materials.py",
        "to": "scripts/sk8_materials.py"
      },
      {
        "from": "public/img/textures/asphalt",
        "to": "public/img/textures/asphalt"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Graphics",
      "artifactName": "${productName}-${version}-${os}.${ext}"
    },
    "win": {
      "target": [
        "dir"
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ReSkate Map Creator"
    }
  }
}
